# This is a sample file. Please create a new file named ".env" in this same directory
# and fill in your actual credentials below. This .env file is ignored by git,
# so your credentials will remain private.

# --- VPN Credentials ---
VPN_SERVER="your.vpn.server.address"
VPN_USER="your_vpn_username"
VPN_PASS="your_vpn_password"

# --- Extranet Website Credentials ---
WEB_USER="your_website_username"
WEB_PASS="your_website_password"
